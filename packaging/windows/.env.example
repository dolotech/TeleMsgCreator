# TeleMsgCreator 配置
#
# 这个文件是模板。要改配置有两种方式：
#   1) 双击 edit-config.bat，把本文件另存为 .env 后再改（推荐）；
#   2) 直接启动程序，在网页的「设置」里填写并保存 —— 程序会自动生成 .env。

# 必填：找 @BotFather 申请
TELEMSG_BOT_TOKEN=

# 可选：默认发送目标，例如 @my_channel
TELEMSG_DEFAULT_CHAT_ID=

# 数据存放位置（相对路径即「本程序所在目录」）
TELEMSG_DB_PATH=data/telemsg.sqlite3
TELEMSG_UPLOAD_DIR=data/uploads

# Web 编辑器
TELEMSG_UI_HOST=127.0.0.1
TELEMSG_UI_PORT=8765
# 想让局域网里的人访问时，取消下面注释并改成强密码（用户名固定 telemsg）
# TELEMSG_UI_PASSWORD=

# 可选：走代理时填写，例如 http://127.0.0.1:7890
# TELEMSG_PROXY=

TELEMSG_LOG_LEVEL=INFO
