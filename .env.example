# 复制为 .env 后填写真实值；所有变量都以 TELEMSG_ 开头

# 必填：找 @BotFather 申请
TELEMSG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：默认发送目标（@频道用户名 或 -100 开头的数字 ID）
TELEMSG_DEFAULT_CHAT_ID=@your_channel

# 可选：自建 Bot API Server（上传上限可提到 2GB）
# TELEMSG_API_BASE=http://127.0.0.1:8081

# 可选：数据与媒体存放位置
TELEMSG_DB_PATH=data/telemsg.sqlite3
TELEMSG_UPLOAD_DIR=data/uploads

# 可选：网络与重试
TELEMSG_TIMEOUT_SECONDS=30
TELEMSG_MAX_RETRIES=3
# TELEMSG_PROXY=http://127.0.0.1:7890

# 可选：Web 编辑器
TELEMSG_UI_HOST=127.0.0.1
TELEMSG_UI_PORT=8765
# TELEMSG_UI_PASSWORD=请改成强密码

# 可选：调试
TELEMSG_LOG_LEVEL=INFO
